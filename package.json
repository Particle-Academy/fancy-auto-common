{
  "name": "@particle-academy/fancy-auto-common",
  "version": "0.2.0",
  "description": "Shared headless primitives for autonomous UX drivers — the activity bus, effect-dispatch registry, per-actor undo stack, and presence types used by both agent-integrations (agent-driven UX) and fancy-flow's FlowRunnerUx (flow-driven UX). Zero runtime dependencies; React is an optional peer for the /react hook.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-auto-common.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-auto-common#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-auto-common/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "activity",
    "presence",
    "undo",
    "headless",
    "agent",
    "flow",
    "human-plus-ux",
    "fancy"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
